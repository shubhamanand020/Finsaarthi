# FinSaarthi Frontend - Environment Variables Template
# Copy this file to .env and fill in with your deployment values

# API Base URL for backend communication
# For local development: http://localhost:8080/api
# For production: https://your-backend-domain/api
# Example Railway deployment: https://finsaarthibackend-production.up.railway.app/api
# Important: include https:// and the /api suffix
VITE_API_URL=http://localhost:8080/api
