@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* ═══════════════════════════════════════════════
   CSS DESIGN TOKENS  |  Light & Dark Themes
   Brand: FinSaarthi Orange
═══════════════════════════════════════════════ */

:root,
[data-theme="light"] {
  /* Backgrounds */
  --bg-base:        #f5f5f7;
  --bg-surface:     #ffffff;
  --bg-elevated:    #ffffffcc;
  --bg-overlay:     rgba(255,255,255,0.72);

  /* Text */
  --text-primary:   #1d1d1f;
  --text-secondary: #6e6e73;
  --text-tertiary:  #aeaeb2;

  /* Borders */
  --border:         rgba(0,0,0,0.08);
  --border-strong:  rgba(0,0,0,0.14);

  /* Brand gradient — orange to amber */
  --grad-start:     #EA580C;
  --grad-mid:       #F97316;
  --grad-end:       #FB923C;

  /* Glass */
  --glass-bg:       rgba(255,255,255,0.45);
  --glass-border:   rgba(255,255,255,0.70);
  --glass-shadow:   0 8px 32px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.06);

  /* Nav */
  --nav-bg:         rgba(242,242,247,0.55);

  /* Input */
  --input-bg:       rgba(255,255,255,0.60);
  --input-border:   rgba(0,0,0,0.12);
  --input-focus:    #EA580C;

  /* Button */
  --btn-primary-bg:     linear-gradient(135deg, #EA580C 0%, #F97316 55%, #FB923C 100%);
  --btn-primary-shadow: 0 4px 20px rgba(234,88,12,0.32);

  /* Hero gradient mesh — warm orange tint */
  --hero-from: #fff7ed;
  --hero-to:   #fef3c7;
  --orb-1:     rgba(234, 88,  12,  0.13);
  --orb-2:     rgba(251, 146, 60,  0.10);
  --orb-3:     rgba(245, 158, 11,  0.08);
}

[data-theme="dark"] {
  /* Backgrounds — pure Apple dark */
  --bg-base:        #000000;
  --bg-surface:     #1c1c1e;
  --bg-elevated:    #2c2c2e;
  --bg-overlay:     rgba(28,28,30,0.80);

  /* Text */
  --text-primary:   #f5f5f7;
  --text-secondary: #98989d;
  --text-tertiary:  #636366;

  /* Borders */
  --border:         rgba(255,255,255,0.08);
  --border-strong:  rgba(255,255,255,0.14);

  /* Brand gradient — vivid orange on dark */
  --grad-start:     #F97316;
  --grad-mid:       #FB923C;
  --grad-end:       #FBBF24;

  /* Glass */
  --glass-bg:       rgba(28,28,30,0.40);
  --glass-border:   rgba(255,255,255,0.18);
  --glass-shadow:   0 8px 32px rgba(0,0,0,0.65), 0 2px 8px rgba(0,0,0,0.35);

  /* Nav */
  --nav-bg:         rgba(0,0,0,0.45);

  /* Input */
  --input-bg:       rgba(44,44,46,0.50);
  --input-border:   rgba(255,255,255,0.15);
  --input-focus:    #F97316;

  /* Button */
  --btn-primary-bg:     linear-gradient(135deg, #EA580C 0%, #F97316 55%, #FB923C 100%);
  --btn-primary-shadow: 0 4px 24px rgba(249,115,22,0.42);

  /* Hero gradient mesh — deep warm dark */
  --hero-from: #0d0500;
  --hero-to:   #120800;
  --orb-1:     rgba(234, 88,  12,  0.18);
  --orb-2:     rgba(251, 146, 60,  0.13);
  --orb-3:     rgba(245, 158, 11,  0.10);
}

/* ═══════════════════════════════════════════════
   BASE RESET
═══════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; }

html {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg-base);
  color: var(--text-primary);
  transition: background 0.35s ease, color 0.35s ease;
  min-height: 100vh;
}

/* ═══════════════════════════════════════════════
   PAGE FADE-IN  (each route animates in)
═══════════════════════════════════════════════ */
@keyframes pageFadeIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

.page-enter {
  animation: pageFadeIn 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}

/* ═══════════════════════════════════════════════
   NAVIGATION  (frosted glass top bar)
═══════════════════════════════════════════════ */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--nav-bg);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid var(--border);
  transition: background 0.35s ease;
}

.nav-logo-text {
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  background: var(--btn-primary-bg);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.nav-link {
  color: var(--text-secondary);
  font-size: 0.9rem;
  font-weight: 500;
  text-decoration: none;
  padding: 0.35rem 0.75rem;
  border-radius: 0.5rem;
  transition: color 0.2s ease, background 0.2s ease;
}
.nav-link:hover {
  color: var(--text-primary);
  background: var(--border);
}

/* ── Theme Toggle ── */
.theme-toggle {
  width: 44px;
  height: 26px;
  border-radius: 13px;
  border: 1.5px solid var(--border-strong);
  background: var(--bg-elevated);
  position: relative;
  cursor: pointer;
  transition: background 0.3s ease, border-color 0.3s ease;
  flex-shrink: 0;
  padding: 0;
  outline: none;
}
.theme-toggle-knob {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--grad-start), var(--grad-end));
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
}
[data-theme="dark"] .theme-toggle-knob {
  transform: translateX(18px);
}

/* ═══════════════════════════════════════════════
   APPLE-STYLE BUTTON
═══════════════════════════════════════════════ */
.apple-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.8rem 1.75rem;
  border-radius: 980px;            /* pill */
  font-family: inherit;
  font-size: 0.95rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  cursor: pointer;
  border: none;
  outline: none;
  text-decoration: none;
  transition:
    transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1),
    box-shadow 0.22s ease,
    filter 0.22s ease;
  user-select: none;
  position: relative;
  overflow: hidden;
}

/* Primary — gradient */
.apple-btn-primary {
  background: var(--btn-primary-bg);
  color: #ffffff;
  box-shadow: var(--btn-primary-shadow);
}
.apple-btn-primary:hover {
  transform: scale(1.04) translateY(-1px);
  box-shadow: 0 8px 30px rgba(0,122,255,0.40);
  filter: brightness(1.08);
}
.apple-btn-primary:active {
  transform: scale(0.97);
  filter: brightness(0.95);
}

/* Secondary — glass surface */
.apple-btn-secondary {
  background: var(--glass-bg);
  color: var(--text-primary);
  border: 1px solid var(--border-strong);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.apple-btn-secondary:hover {
  transform: scale(1.03) translateY(-1px);
  box-shadow: var(--glass-shadow);
  border-color: var(--grad-start);
  color: var(--grad-start);
}
.apple-btn-secondary:active {
  transform: scale(0.97);
}

/* ═══════════════════════════════════════════════
   APPLE-STYLE INPUT
═══════════════════════════════════════════════ */
.apple-input-wrap {
  position: relative;
  width: 100%;
}

.apple-input {
  width: 100%;
  padding: 0.9rem 1.1rem 0.9rem 2.9rem;
  border-radius: 14px;
  background: var(--input-bg);
  border: 1.5px solid var(--input-border);
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.95rem;
  font-weight: 400;
  outline: none;
  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
.apple-input::placeholder {
  color: var(--text-tertiary);
}
.apple-input:focus {
  border-color: var(--input-focus);
  box-shadow: 0 0 0 3.5px color-mix(in srgb, var(--input-focus) 18%, transparent);
}

.apple-input-icon {
  position: absolute;
  left: 0.9rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-tertiary);
  pointer-events: none;
  transition: color 0.2s;
}
.apple-input-wrap:focus-within .apple-input-icon {
  color: var(--input-focus);
}

/* ═══════════════════════════════════════════════
   GLASS CARD
═══════════════════════════════════════════════ */
.glass-card {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  box-shadow: var(--glass-shadow);
  transition: background 0.35s ease, border-color 0.35s ease;
}

/* ═══════════════════════════════════════════════
   HERO SECTION
═══════════════════════════════════════════════ */
.hero-section {
  position: relative;
  min-height: calc(100vh - 64px);
  display: flex;
  align-items: center;
  overflow: hidden;
  background: linear-gradient(145deg, var(--hero-from) 0%, var(--bg-base) 50%, var(--hero-to) 100%);
  transition: background 0.35s ease;
}

/* floating orbs (ambient light, no cursor JS needed) */
.hero-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  animation: orbFloat 8s ease-in-out infinite alternate;
}
.hero-orb-1 {
  width: 520px; height: 520px;
  top: -120px; left: -100px;
  background: var(--orb-1);
  animation-delay: 0s;
}
.hero-orb-2 {
  width: 420px; height: 420px;
  top: 30%; right: -80px;
  background: var(--orb-2);
  animation-delay: -3s;
}
.hero-orb-3 {
  width: 300px; height: 300px;
  bottom: -80px; left: 40%;
  background: var(--orb-3);
  animation-delay: -5s;
}

@keyframes orbFloat {
  from { transform: translate(0, 0) scale(1); }
  to   { transform: translate(30px, -30px) scale(1.05); }
}

/* ── Hero badge chip ── */
.hero-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.35rem 0.9rem;
  border-radius: 980px;
  background: var(--glass-bg);
  border: 1px solid var(--border-strong);
  backdrop-filter: blur(12px);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
}
.hero-chip-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--btn-primary-bg);
}

/* ── Hero heading ── */
.hero-heading {
  font-size: clamp(2.4rem, 5.5vw, 4.2rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1.08;
  color: var(--text-primary);
}
.hero-heading-gradient {
  background: var(--btn-primary-bg);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero-sub {
  font-size: 1.1rem;
  line-height: 1.65;
  color: var(--text-secondary);
  max-width: 48ch;
}

/* ═══════════════════════════════════════════════
   STAT / FEATURE CARDS
═══════════════════════════════════════════════ */
.stat-card {
  padding: 1.5rem;
  border-radius: 18px;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  transition:
    transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
    box-shadow 0.28s ease,
    background 0.35s ease,
    border-color 0.35s ease;
}
.stat-card:hover {
  transform: translateY(-4px) scale(1.02);
  box-shadow: 0 12px 40px rgba(0,0,0,0.10);
  border-color: var(--border-strong);
}

.feature-card {
  padding: 2rem;
  border-radius: 20px;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  transition:
    transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
    box-shadow 0.28s ease,
    background 0.35s ease;
}
.feature-card:hover {
  transform: translateY(-6px) scale(1.01);
  box-shadow: 0 16px 48px rgba(0,0,0,0.12);
}

.icon-pill {
  width: 48px; height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--btn-primary-bg);
  color: #fff;
  margin-bottom: 1.2rem;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.feature-card:hover .icon-pill {
  transform: scale(1.12) rotate(-3deg);
}

/* ═══════════════════════════════════════════════
   CTA SECTION
═══════════════════════════════════════════════ */
.cta-section {
  position: relative;
  padding: 7rem 1.5rem;
  text-align: center;
  overflow: hidden;
  background: var(--bg-surface);
  border-top: 1px solid var(--border);
  transition: background 0.35s ease;
}
.cta-gradient-text {
  background: var(--btn-primary-bg);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ═══════════════════════════════════════════════
   LOGIN PAGE
═══════════════════════════════════════════════ */
.login-page {
  min-height: calc(100vh - 64px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  background: linear-gradient(145deg, var(--hero-from) 0%, var(--bg-base) 50%, var(--hero-to) 100%);
  transition: background 0.35s ease;
  position: relative;
  overflow: hidden;
}
.login-card {
  width: 100%;
  max-width: 440px;
  padding: 2.8rem 2.5rem;
  border-radius: 28px;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(28px) saturate(200%);
  -webkit-backdrop-filter: blur(28px) saturate(200%);
  box-shadow: var(--glass-shadow);
  position: relative;
  z-index: 1;
}

.login-role-tabs {
  display: flex;
  background: var(--bg-elevated, rgba(0,0,0,0.05));
  border-radius: 12px;
  padding: 3px;
  gap: 3px;
  margin-bottom: 2rem;
  border: 1px solid var(--border);
}
.login-tab {
  flex: 1;
  padding: 0.55rem;
  border-radius: 9px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  background: transparent;
  color: var(--text-secondary);
  transition: background 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
  font-family: inherit;
}
.login-tab.active {
  background: var(--bg-surface);
  color: var(--text-primary);
  box-shadow: 0 1px 6px rgba(0,0,0,0.10);
}

.login-divider {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin: 1.5rem 0;
  color: var(--text-tertiary);
  font-size: 0.8rem;
}
.login-divider::before,
.login-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}

/* ── Error shake ── */
@keyframes shake {
  0%,100% { transform: translateX(0); }
  20%      { transform: translateX(-8px); }
  40%      { transform: translateX(8px); }
  60%      { transform: translateX(-5px); }
  80%      { transform: translateX(5px); }
}
.shake { animation: shake 0.4s ease; }

.error-box {
  background: rgba(255, 59, 48, 0.08);
  border: 1px solid rgba(255, 59, 48, 0.25);
  border-radius: 12px;
  padding: 0.75rem 1rem;
  color: #ff3b30;
  font-size: 0.85rem;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1.25rem;
}

/* ── Password show/hide ── */
.pw-toggle {
  position: absolute;
  right: 0.9rem;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--text-tertiary);
  cursor: pointer;
  padding: 0.2rem;
  line-height: 0;
  transition: color 0.2s;
}
.pw-toggle:hover { color: var(--text-secondary); }

/* ═══════════════════════════════════════════════
   LOADING SPINNER on button
═══════════════════════════════════════════════ */
@keyframes spin { to { transform: rotate(360deg); } }
.btn-spinner {
  width: 16px; height: 16px;
  border: 2px solid rgba(255,255,255,0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  display: inline-block;
}

/* ═══════════════════════════════════════════════
   ACCOUNT DROPDOWN (nav)
═══════════════════════════════════════════════ */
.nav-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 200px;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow: var(--glass-shadow);
  overflow: hidden;
  animation: pageFadeIn 0.2s ease both;
}
.nav-dropdown-item {
  display: block;
  padding: 0.75rem 1.1rem;
  color: var(--text-primary);
  font-size: 0.88rem;
  font-weight: 500;
  text-decoration: none;
  transition: background 0.15s ease;
}
.nav-dropdown-item:hover {
  background: var(--border);
}
.nav-dropdown-sep {
  height: 1px;
  background: var(--border);
}

/* ═══════════════════════════════════════════════
   SECTION LABEL
═══════════════════════════════════════════════ */
.section-label {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-tertiary);
  margin-bottom: 0.75rem;
}

/* ═══════════════════════════════════════════════
   HERO IMAGE CARD
═══════════════════════════════════════════════ */
.hero-img-card {
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 24px 80px rgba(0,0,0,0.18);
  border: 1px solid var(--border);
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              box-shadow 0.5s ease;
  background: var(--bg-surface);
}
.hero-img-card:hover {
  transform: translateY(-8px) rotate(0deg) !important;
  box-shadow: 0 32px 96px rgba(0,0,0,0.22);
}

/* floating badge on hero image */
.hero-badge {
  position: absolute;
  bottom: -1rem;
  left: -1.5rem;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(16px);
  border-radius: 16px;
  padding: 0.9rem 1.2rem;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}

/* ═══════════════════════════════════════════════
   UTILITY HELPERS
═══════════════════════════════════════════════ */
.text-primary   { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-gradient  {
  background: var(--btn-primary-bg);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* remove tailwind ring on buttons */
button:focus-visible { outline: 2px solid var(--input-focus); outline-offset: 2px; }

/* ── Shimmer Animation for Skeletons ── */
@keyframes shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton-shimmer {
  background: linear-gradient(90deg, 
    var(--border) 25%, 
    color-mix(in srgb, var(--border) 80%, var(--text-primary)) 50%, 
    var(--border) 75%
  );
  background-size: 200% 100%;
  animation: shimmer 2s infinite linear;
}

/* ═══════════════════════════════════════════════
   SCROLL REVEAL  —  pop-in on enter, reset on exit
   Works bidirectionally: scroll down AND scroll up
═══════════════════════════════════════════════ */

/* ── Keyframes ── */

/* cards / sections: slide up + scale */
@keyframes revealPopUp {
  0% {
    opacity: 0;
    transform: translateY(32px) scale(0.93);
  }
  60% {
    transform: translateY(-4px) scale(1.02);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* icon pills: elastic bounce */
@keyframes revealIconPop {
  0%   { opacity: 0; transform: scale(0.4) rotate(-8deg); }
  55%  { transform: scale(1.18) rotate(4deg); }
  75%  { transform: scale(0.94) rotate(-2deg); }
  100% { opacity: 1; transform: scale(1) rotate(0deg); }
}

/* text / labels: fade + slide from left */
@keyframes revealFadeLeft {
  0%   { opacity: 0; transform: translateX(-20px); }
  100% { opacity: 1; transform: translateX(0); }
}

/* numbers: count-up feel — fade + slide from below */
@keyframes revealFadeUp {
  0%   { opacity: 0; transform: translateY(18px); }
  100% { opacity: 1; transform: translateY(0); }
}

/* ── Base hidden state ── */
.reveal-hidden {
  opacity: 0;
  transform: translateY(32px) scale(0.93);
  /* no transition — instant hide so re-scroll re-animates cleanly */
}

/* ── Visible state — triggers animation ── */
.reveal-visible {
  animation-fill-mode: both;
  animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
  animation-delay: var(--reveal-delay, 0s);
}

/* Default reveal (cards, sections) */
.reveal-visible {
  animation-name: revealPopUp;
  animation-duration: 0.55s;
}

/* Icon pill variant */
.reveal-visible[data-reveal="icon"] {
  animation-name: revealIconPop;
  animation-duration: 0.6s;
  animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* Text / label variant */
.reveal-visible[data-reveal="text"] {
  animation-name: revealFadeLeft;
  animation-duration: 0.45s;
  animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Number / stat variant */
.reveal-visible[data-reveal="stat"] {
  animation-name: revealFadeUp;
  animation-duration: 0.5s;
  animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
